# ─────────────────────────────────────────────────────────────
# Enterprise Context Brain (ECB) v2.2 — Environment Configuration
# Copy this file to .env and fill in your API keys.
# At least ONE LLM key is needed for real AI synthesis.
# Without keys, ECB runs in simulated (deterministic) mode.
# ─────────────────────────────────────────────────────────────

# ── LLM Provider API Keys ────────────────────────────────────
# Get free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get free Groq key: https://console.groq.com/keys
GROQ_API_KEY=

# ── Model Selection (optional, defaults shown) ───────────────
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# ── LLM Mode ─────────────────────────────────────────────────
# "auto"      → Gemini first, Groq fallback, then simulated
# "gemini"    → Gemini only (error if no key)
# "groq"      → Groq only (error if no key)
# "simulated" → Always use deterministic fixture responses
ECB_LLM_MODE=auto
